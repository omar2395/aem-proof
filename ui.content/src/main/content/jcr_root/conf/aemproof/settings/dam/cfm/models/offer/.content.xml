<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="cq:Template"
    jcr:title="Offer"
    jcr:description="One commercial offer shown in the offers grid"
    allowedPaths="[/content/dam(/.*)?]"
    ranking="{Long}100">
    <jcr:content
        cq:scaffolding="/conf/aemproof/settings/dam/cfm/models/offer/jcr:content/model"
        cq:templateType="/libs/settings/dam/cfm/model-types/fragment"
        jcr:primaryType="nt:unstructured"
        sling:resourceType="dam/cfm/models/console/components/data/entity/default">
        <model
            cq:targetPath="/content/entities"
            jcr:primaryType="cq:PageContent"
            sling:resourceType="wcm/scaffolding/components/scaffolding"
            dataTypesConfig="/mnt/overlay/settings/dam/cfm/models/formbuilderconfig/datatypes"
            maxGeneratedOrder="20">
            <cq:dialog
                jcr:primaryType="nt:unstructured"
                sling:resourceType="cq/gui/components/authoring/dialog">
                <content
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns">
                    <items jcr:primaryType="nt:unstructured">
                        <title
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                            fieldLabel="العنوان"
                            listOrder="1"
                            metaType="text-single"
                            name="title"
                            required="{Boolean}true"
                            valueType="string"/>
                        <price
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/numberfield"
                            fieldLabel="السعر"
                            listOrder="2"
                            metaType="number"
                            name="price"
                            valueType="double"/>
                        <currency
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                            fieldLabel="العملة"
                            listOrder="3"
                            metaType="text-single"
                            name="currency"
                            value="SAR"
                            valueType="string"/>
                        <image
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                            fieldLabel="الصورة"
                            listOrder="4"
                            metaType="content-reference"
                            name="image"
                            rootPath="/content/dam/aemproof"
                            valueType="string"/>
                        <validUntil
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/datepicker"
                            fieldLabel="صالح حتى"
                            listOrder="5"
                            metaType="date"
                            name="validUntil"
                            type="date"
                            valueType="calendar"/>
                        <tags
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                            fieldLabel="الوسوم"
                            listOrder="6"
                            metaType="text-single"
                            name="tags"
                            valueType="string[]">
                            <field
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                name="tags"/>
                        </tags>
                    </items>
                </content>
            </cq:dialog>
        </model>
    </jcr:content>
</jcr:root>
