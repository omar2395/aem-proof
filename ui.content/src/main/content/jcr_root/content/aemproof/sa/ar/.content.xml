<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="cq:Page">
    <jcr:content
        cq:contextHubPath="/etc/cloudsettings/default/contexthub"
        cq:contextHubSegmentsPath="/etc/segmentation/contexthub"
        cq:template="/conf/aemproof/settings/wcm/templates/page-content"
        jcr:language="ar"
        jcr:primaryType="cq:PageContent"
        jcr:title="عروض هذا الأسبوع"
        pageTitle="عروض هذا الأسبوع — AEM Proof"
        sling:resourceType="aemproof/components/page">
        <root
            jcr:primaryType="nt:unstructured"
            sling:resourceType="aemproof/components/container"
            layout="responsiveGrid">
            <container
                jcr:primaryType="nt:unstructured"
                sling:resourceType="aemproof/components/container">
                <title
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="aemproof/components/title"
                    jcr:title="عروض هذا الأسبوع"
                    type="h1"/>
                <container
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="aemproof/components/container"
                    layout="responsiveGrid">
                    <offers_grid
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="aemproof/components/offers-grid"
                        source="cf"
                        cfFolder="/content/dam/aemproof/offers"
                        limit="{Long}6"
                        fallbackText="لا توجد عروض حالياً"/>
                    <api_status
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="aemproof/components/api-status"
                        label="ربط العروض"/>
                </container>
            </container>
        </root>
    </jcr:content>
</jcr:root>
