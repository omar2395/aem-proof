                jcr:primaryType="nt:unstructured"
                title="20% off specialty coffee"
                price="{Double}12.0"
                currency="SAR"
                image="/content/dam/aemproof/offers/images/coffee.jpg"
                validUntil="{Date}2026-10-31T00:00:00.000+03:00"
