                currency="SAR"
                image="/content/dam/aemproof/offers/images/delivery.jpg"
                validUntil="{Date}2026-12-31T00:00:00.000+03:00"
                tags="[delivery]"/>
            <en
                jcr:primaryType="nt:unstructured"
                title="Free delivery over 100 SAR"
                price="{Double}0.0"
                currency="SAR"
                image="/content/dam/aemproof/offers/images/delivery.jpg"
                validUntil="{Date}2026-12-31T00:00:00.000+03:00"
                tags="[delivery]"/>
        </data>
        <metadata
            jcr:primaryType="nt:unstructured"
            dam:title="Free delivery over 100 SAR"/>
